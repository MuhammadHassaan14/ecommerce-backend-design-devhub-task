<%- include('partials/header') %>
<main class="flex-grow pb-12">
<div class="container py-4">
    <div class="flex items-center gap-2 text-[#8B96A5] text-sm mb-6">
        <a href="/" class="cursor-pointer hover:text-primary transition-colors">Home</a>
        <i data-lucide="chevron-right" class="w-4 h-4"></i>
        <a href="/products" class="cursor-pointer hover:text-primary transition-colors">Products</a>
        <i data-lucide="chevron-right" class="w-4 h-4"></i>
        <span class="text-[#1C1C1C] font-normal"><%= product.title %></span>
    </div>

    <div class="bg-white border border-[#DEE2E7] rounded-lg p-5 lg:p-8 flex flex-col lg:flex-row gap-8 mb-8 shadow-sm">
        <div class="lg:w-[450px] flex-shrink-0">
            <div class="border border-[#DEE2E7] rounded-lg p-8 mb-4 flex items-center justify-center bg-[#F7F7F7] aspect-square overflow-hidden group">
                <img src="<%= product.image %>" alt="<%= product.title %>" class="max-w-full max-h-full object-contain group-hover:scale-105 transition-transform duration-500" />
            </div>
        </div>

        <div class="flex-1">
            <div class="flex items-center gap-2 text-[#00B517] mb-2">
                <i data-lucide="check" class="w-5 h-5"></i>
                <span class="text-sm font-medium">In stock (<%= product.condition %>)</span>
            </div>
            <h1 class="text-xl lg:text-2xl font-bold text-[#1C1C1C] mb-4">
                <%= product.title %>
            </h1>

            <div class="flex items-center gap-4 mb-4">
                <div class="flex items-center gap-1">
                    <% for(let i=0; i<5; i++) { %>
                        <i data-lucide="star" class="w-4 h-4 <%= i < Math.floor(product.rating) ? 'fill-[#FF9017] text-[#FF9017]' : 'text-[#D1D3D3]' %>"></i>
                    <% } %>
                    <span class="text-[#FF9017] text-sm ml-1"><%= product.rating %></span>
                </div>
                <div class="flex items-center gap-1 text-[#8B96A5] text-sm">
                    <i data-lucide="message-square" class="w-4 h-4"></i>
                    <span>32 reviews</span>
                </div>
                <div class="flex items-center gap-1 text-[#8B96A5] text-sm">
                    <i data-lucide="shopping-bag" class="w-4 h-4"></i>
                    <span><%= product.orders %> sold</span>
                </div>
            </div>

            <div class="bg-[#FFF0DF] p-4 rounded-lg flex flex-wrap gap-8 items-center mb-6">
                <div class="flex flex-col">
                    <span class="text-xl lg:text-3xl font-bold text-[#FA3434]">$<%= product.price.toFixed(2) %></span>
                    <% if(product.oldPrice) { %>
                        <span class="text-xs text-[#505050] line-through">was $<%= product.oldPrice.toFixed(2) %></span>
                    <% } %>
                </div>
            </div>

            <div class="space-y-4 mb-8">
                <div class="grid grid-cols-3 lg:grid-cols-4 gap-4 text-sm">
                    <span class="text-[#8B96A5]">Brand:</span>
                    <span class="col-span-2 lg:col-span-3 text-[#505050]"><%= product.brand %></span>
                </div>
                <div class="grid grid-cols-3 lg:grid-cols-4 gap-4 text-sm border-t border-[#DEE2E7] pt-4">
                    <span class="text-[#8B96A5]">Category:</span>
                    <span class="col-span-2 lg:col-span-3 text-[#505050]"><%= product.category %></span>
                </div>
            </div>

            <div class="h-[1px] bg-[#DEE2E7] mb-8"></div>

            <div class="space-y-6">
                <div class="flex flex-wrap gap-4">
                    <button class="flex-1 min-w-[150px] bg-primary hover:bg-primary-dark text-white py-3 rounded-lg font-bold transition-colors">
                        Buy Now
                    </button>
                    <button class="flex-1 min-w-[150px] bg-[#E3F0FF] hover:bg-[#D1E9FF] text-primary py-3 rounded-lg font-bold transition-colors">
                        Add to Cart
                    </button>
                    <button class="w-12 h-12 flex items-center justify-center border border-[#DEE2E7] rounded-lg text-primary hover:bg-shade transition-colors">
                        <i data-lucide="heart" class="w-5 h-5"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Related Products -->
    <% if (relatedProducts && relatedProducts.length > 0) { %>
    <div class="bg-white border border-[#DEE2E7] rounded-lg p-5 lg:p-6 mb-8 mt-6">
        <h4 class="font-bold text-[#1C1C1C] text-lg mb-4">Related products</h4>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
            <% relatedProducts.forEach(rel => { %>
                <a href="/products/<%= rel._id %>" class="flex flex-col gap-3 group">
                    <div class="w-full aspect-square border border-[#DEE2E7] rounded-lg p-3 flex items-center justify-center bg-white cursor-pointer group-hover:shadow-md transition-all duration-300">
                        <img src="<%= rel.image %>" alt="<%= rel.title %>" class="max-w-full max-h-full object-contain group-hover:scale-110 transition-transform duration-500" />
                    </div>
                    <div class="flex flex-col">
                        <span class="text-[#505050] text-sm line-clamp-2 group-hover:text-primary transition-colors cursor-pointer"><%= rel.title %></span>
                        <span class="text-[#8B96A5] text-sm mt-1">$<%= rel.price.toFixed(2) %></span>
                    </div>
                </a>
            <% }) %>
        </div>
    </div>
    <% } %>

</div>
</main>
<%- include('partials/footer') %>
