<%- include('partials/header') %>
<main class="flex-grow pb-12">
<div class="container py-4">
         
         <div class="flex items-center gap-2 text-[#8B96A5] text-sm mb-6">
            <span class="cursor-pointer hover:text-primary transition-colors" >Home</span>
            <i data-lucide="chevron-right"></i>
            <span class="cursor-pointer hover:text-primary transition-colors">Clothings</span>
            <i data-lucide="chevron-right"></i>
            <span class="cursor-pointer hover:text-primary transition-colors">Men's wear</span>
            <i data-lucide="chevron-right"></i>
            <span class="text-[#1C1C1C] font-normal">Summer clothing</span>
         </div>

         
         <div class="bg-white border border-[#DEE2E7] rounded-lg p-5 lg:p-8 flex flex-col lg:flex-row gap-8 mb-8 shadow-sm">
            
            <div class="lg:w-[450px] flex-shrink-0">
               <div class="border border-[#DEE2E7] rounded-lg p-8 mb-4 flex items-center justify-center bg-[#F7F7F7] aspect-square overflow-hidden group">
                  <img src={thumbnails[selectedThumb]} alt="Product" class="max-w-full max-h-full object-contain group-hover:scale-105 transition-transform duration-500" />
               </div>
               <div class="flex gap-3 overflow-x-auto no-scrollbar">
                  <% [1,2,3,4,5].forEach((item) => { %>
                     <div
                        key=Sample
                        class={`w-[56px] h-[56px] border rounded-md cursor-pointer flex items-center justify-center p-1 bg-[#F7F7F7] hover:border-primary transition-colors ${selectedThumb === i ? 'border-primary shadow-sm' : 'border-[#DEE2E7]'}`}
                        
                     >
                        <img src="/assets/Layout1/Image/flags/DE@2x.png" alt={`thumb-$Sample`} class="max-w-[85%] max-h-[85%] object-contain" />
                     </div>
                  <% }) %>
               </div>
            </div>

            
            <div class="flex-1">
               <div class="flex items-center gap-2 text-[#00B517] mb-2">
                  <i data-lucide="Check" class="w-[20px] h-[20px]"></i>
                  <span class="text-sm font-medium">In stock</span>
               </div>
               <h1 class="text-xl lg:text-2xl font-bold text-[#1C1C1C] mb-4">
                  Mens Long Sleeve T-shirt Cotton Base Layer Slim Muscle
               </h1>

               
               <div class="flex items-center gap-4 mb-4">
                  <div class="flex items-center gap-1">
                     {[5, 4, 3, 2, 1].map((s, i) => <i data-lucide="Star" class="w-[16px] h-[16px]"></i>)}
                     <span class="text-[#FF9017] text-sm ml-1">4.5</span>
                  </div>
                  <div class="flex items-center gap-1 text-[#8B96A5] text-sm">
                     <i data-lucide="MessageSquare" class="w-[16px] h-[16px]"></i>
                     <span>32 reviews</span>
                  </div>
                  <div class="flex items-center gap-1 text-[#8B96A5] text-sm">
                     <i data-lucide="ShoppingBag" class="w-[16px] h-[16px]"></i>
                     <span>154 sold</span>
                  </div>
               </div>

               
               <div class="bg-[#FFF0DF] p-4 rounded-lg flex flex-wrap gap-8 items-center mb-6">
                  <div class="flex flex-col">
                     <span class="text-xl lg:text-3xl font-bold text-[#FA3434]">$98.00</span>
                     <span class="text-xs text-[#505050]">50-100 pcs</span>
                  </div>
                  <div class="h-10 w-[1px] bg-[#DEE2E7] hidden lg:block"></div>
                  <div class="flex flex-col">
                     <span class="text-lg lg:text-2xl font-bold text-[#1C1C1C]">$90.00</span>
                     <span class="text-xs text-[#505050]">100-700 pcs</span>
                  </div>
                  <div class="h-10 w-[1px] bg-[#DEE2E7] hidden lg:block"></div>
                  <div class="flex flex-col">
                     <span class="text-lg lg:text-2xl font-bold text-[#1C1C1C]">$78.00</span>
                     <span class="text-xs text-[#505050]">700+ pcs</span>
                  </div>
               </div>

               
               <div class="space-y-4 mb-8">
                  <div class="grid grid-cols-3 lg:grid-cols-4 gap-4 text-sm">
                     <span class="text-[#8B96A5]">Price:</span>
                     <span class="col-span-2 lg:col-span-3 text-[#505050]">Negotiable</span>
                  </div>
                  <div class="grid grid-cols-3 lg:grid-cols-4 gap-4 text-sm border-t border-[#DEE2E7] pt-4">
                     <span class="text-[#8B96A5]">Type:</span>
                     <span class="col-span-2 lg:col-span-3 text-[#505050]">Classic shoe</span>
                  </div>
                  <div class="grid grid-cols-3 lg:grid-cols-4 gap-4 text-sm border-t border-[#DEE2E7] pt-4">
                     <span class="text-[#8B96A5]">Material:</span>
                     <span class="col-span-2 lg:col-span-3 text-[#505050]">Plastic material</span>
                  </div>
                  <div class="grid grid-cols-3 lg:grid-cols-4 gap-4 text-sm border-t border-[#DEE2E7] pt-4">
                     <span class="text-[#8B96A5]">Design:</span>
                     <span class="col-span-2 lg:col-span-3 text-[#505050]">Modern design</span>
                  </div>
               </div>

               <div class="h-[1px] bg-[#DEE2E7] mb-8"></div>

               
               <div class="space-y-6">
                  <div class="flex items-center gap-4">
                     <span class="text-sm text-[#505050] w-16">Size:</span>
                     <div class="flex gap-2">
                        {['Small', 'Medium', 'Large'].map(size => (
                           <button key=Sample class="px-4 py-2 border border-[#DEE2E7] rounded-md text-sm font-medium hover:border-primary hover:text-primary transition-colors bg-white">
                              Sample
                           </button>
                        <% }) %>
                     </div>
                  </div>

                  <div class="flex flex-wrap gap-4">
                     <button
                        class="flex-1 min-w-[150px] bg-primary hover:bg-primary-dark text-white py-3 rounded-lg font-bold transition-colors"
                        
                     >
                        Buy Now
                     </button>
                     <button
                        class="flex-1 min-w-[150px] bg-[#E3F0FF] hover:bg-[#D1E9FF] text-primary py-3 rounded-lg font-bold transition-colors"
                        
                     >
                        Add to Cart
                     </button>
                     <button class="w-12 h-12 flex items-center justify-center border border-[#DEE2E7] rounded-lg text-primary hover:bg-shade transition-colors">
                        <i data-lucide="Heart" class="w-[20px] h-[20px]"></i>
                     </button>
                  </div>
               </div>
            </div>

            
            <div class="lg:w-[280px] space-y-4">
               
               <div class="bg-white border border-[#DEE2E7] rounded-lg p-5">
                  <div class="flex items-center gap-3 mb-4">
                     <div class="w-12 h-12 rounded-md bg-[#E3F0FF] flex items-center justify-center text-primary font-bold text-xl uppercase">R</div>
                     <div class="flex flex-col">
                        <span class="text-[#1C1C1C] font-normal">Supplier</span>
                        <span class="text-[#505050] text-sm">Guanjhou Trading Co.</span>
                     </div>
                  </div>
                  <div class="h-[1px] bg-[#DEE2E7] mb-4"></div>
                  <div class="space-y-3 mb-5">
                     <div class="flex items-center gap-3 text-sm text-[#8B96A5]">
                        <img src="/assets/Layout1/Image/flags/DE@2x.png" alt="DE" class="w-5 h-3 rounded-sm" />
                        <span>Germany, Berlin</span>
                     </div>
                     <div class="flex items-center gap-3 text-sm text-[#8B96A5]">
                        <i data-lucide="ShieldCheck" class="w-[18px] h-[18px]"></i>
                        <span>Verified Seller</span>
                     </div>
                     <div class="flex items-center gap-3 text-sm text-[#8B96A5]">
                        <i data-lucide="Globe" class="w-[18px] h-[18px]"></i>
                        <span>Worldwide shipping</span>
                     </div>
                  </div>
                  <div class="space-y-2">
                     <button class="w-full bg-primary text-white py-2 rounded-lg text-sm font-medium hover:bg-primary-dark transition-colors">Send inquiry</button>
                     <button class="w-full bg-white text-primary border border-[#DEE2E7] py-2 rounded-lg text-sm font-medium hover:bg-shade transition-colors">Seller's profile</button>
                  </div>
               </div>

               <div class="text-center p-4">
                  <button class="flex items-center justify-center gap-2 text-primary font-medium hover:underline text-sm w-full">
                     <i data-lucide="Heart" class="w-[18px] h-[18px]"></i>
                     <span>Save for later</span>
                  </button>
               </div>
            </div>
         </div>

         
         <div class="flex flex-col lg:flex-row gap-8">
            <div class="flex-1">
               <div class="bg-white border border-[#DEE2E7] rounded-lg overflow-hidden mb-8">
                  <div class="flex border-b border-[#DEE2E7] bg-white overflow-x-auto no-scrollbar">
                     <% [1,2,3,4,5].forEach((item) => { %>
                        <button key=Sample class={`px-6 py-4 text-sm font-medium transition-colors border-b-2 ${i === 0 ? 'text-primary border-primary' : 'text-[#8B96A5] border-transparent hover:text-primary'}`}>
                           Sample
                        </button>
                     <% }) %>
                  </div>
                  <div class="p-6 lg:p-8">
                     <p class="text-[#505050] text-sm lg:text-base leading-relaxed mb-6">
                        Lorem ipsum dolor sit amet, consectetur adipisicing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.
                     </p>
                     <table class="w-full text-sm lg:text-base mb-8 rounded overflow-hidden border-collapse">
                        <tbody>
                           <tr class="border border-[#DEE2E7]">
                              <td class="w-1/3 bg-[#F7FAFC] p-3 text-[#505050] font-medium border-r border-[#DEE2E7]">Model</td>
                              <td class="p-3 text-[#505050]"># 8786867</td>
                           </tr>
                           <tr class="border border-[#DEE2E7]">
                              <td class="w-1/3 bg-[#F7FAFC] p-3 text-[#505050] font-medium border-r border-[#DEE2E7]">Style</td>
                              <td class="p-3 text-[#505050]">Classic style</td>
                           </tr>
                           <tr class="border border-[#DEE2E7]">
                              <td class="w-1/3 bg-[#F7FAFC] p-3 text-[#505050] font-medium border-r border-[#DEE2E7]">Certificate</td>
                              <td class="p-3 text-[#505050]">ISO-8989</td>
                           </tr>
                           <tr class="border border-[#DEE2E7]">
                              <td class="w-1/3 bg-[#F7FAFC] p-3 text-[#505050] font-medium border-r border-[#DEE2E7]">Size</td>
                              <td class="p-3 text-[#505050]">34mm x 450mm x 19mm</td>
                           </tr>
                           <tr class="border border-[#DEE2E7]">
                              <td class="w-1/3 bg-[#F7FAFC] p-3 text-[#505050] font-medium border-r border-[#DEE2E7]">Memory</td>
                              <td class="p-3 text-[#505050]">32GB RAM / 1TB SSD</td>
                           </tr>
                        </tbody>
                     </table>
                     <div class="space-y-3">
                        <% [1,2,3,4,5].forEach((item) => { %>
                           <div key=Sample class="flex items-center gap-3 text-[#505050] text-sm">
                              <i data-lucide="Check" class="w-[16px] h-[16px]"></i>
                              <span>Sample</span>
                           </div>
                        <% }) %>
                     </div>
                  </div>
               </div>
            </div>

            
            <aside class="lg:w-[280px]">
               <div class="bg-white border border-[#DEE2E7] rounded-lg p-5">
                  <h4 class="font-bold text-[#1C1C1C] mb-4">You may like</h4>
                  <div class="space-y-4">
                     <% [1,2,3,4,5].forEach((item) => { %>
                        <div key=Sample class="flex items-center gap-4 group cursor-pointer p-2 hover:bg-[#F7FAFC] rounded-lg transition-colors">
                           <div class="w-20 h-20 border border-[#DEE2E7] rounded-md p-2 flex items-center justify-center bg-white group-hover:shadow-sm transition-shadow">
                              <img src="/assets/Layout1/Image/flags/DE@2x.png" alt="suggested" class="max-w-full max-h-full object-contain group-hover:scale-110 transition-transform duration-300" />
                           </div>
                           <div class="flex flex-col">
                              <span class="text-[#1C1C1C] text-sm font-normal group-hover:text-primary transition-colors line-clamp-1 font-medium">Apple Watch Series Space Gray</span>
                              <span class="text-[#8B96A5] text-sm">$7.00 - $99.50</span>
                           </div>
                        </div>
                     <% }) %>
                  </div>
               </div>
            </aside>
         </div>

         
         <div class="bg-white border border-[#DEE2E7] rounded-lg p-5 lg:p-6 mb-8 mt-6">
            <h4 class="font-bold text-[#1C1C1C] text-lg mb-4">Related products</h4>
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
               {[
                  { tag: "Xiaomi Redmi 8 Original", price: "$32.00-$40.00", img: thumb1 },
                  { tag: "Xiaomi Redmi 8 Original", price: "$32.00-$40.00", img: thumb2 },
                  { tag: "Xiaomi Redmi 8 Original", price: "$32.00-$40.00", img: thumb3 },
                  { tag: "Xiaomi Redmi 8 Original", price: "$32.00-$40.00", img: thumb4 },
                  { tag: "Xiaomi Redmi 8 Original", price: "$32.00-$40.00", img: thumb1 },
                  { tag: "Xiaomi Redmi 8 Original", price: "$32.00-$40.00", img: thumb2 },
               ].map((item, i) => (
                  <div key=Sample class="flex flex-col gap-3 group">
                     <div class="w-full aspect-square border border-[#DEE2E7] rounded-lg p-3 flex items-center justify-center bg-white cursor-pointer group-hover:shadow-[0px_4px_15px_rgba(0,0,0,0.08)] group-hover:-translate-y-1 transition-all duration-300">
                        <img src=Sample Text alt="related" class="max-w-full max-h-full object-contain group-hover:scale-110 transition-transform duration-500" />
                     </div>
                     <div class="flex flex-col">
                        <span class="text-[#505050] text-sm line-clamp-2 group-hover:text-primary transition-colors cursor-pointer">Sample Text</span>
                        <span class="text-[#8B96A5] text-sm mt-1">Sample Text</span>
                     </div>
                  </div>
               <% }) %>
            </div>
         </div>

         
         <div class="bg-gradient-to-r from-primary to-[#005ADE] rounded-lg p-8 flex flex-col md:flex-row items-center justify-between gap-6 mb-8 text-white relative overflow-hidden">
            <div class="relative z-10 text-center md:text-left">
               <h2 class="text-xl lg:text-2xl font-bold mb-2">Super discount on more than 100 USD</h2>
               <p class="opacity-80 text-sm">Have you ever finally just for dummy info.</p>
            </div>
            <button class="relative z-10 bg-[#FF9017] hover:bg-[#E38015] text-white px-8 py-3 rounded-lg font-bold transition-colors shadow-lg">
               Shop now
            </button>
            <div class="absolute top-0 right-0 w-64 h-64 bg-white opacity-5 rounded-full -mr-20 -mt-20"></div>
            <div class="absolute bottom-0 left-0 w-32 h-32 bg-white opacity-5 rounded-full -ml-10 -mb-10"></div>
         </div>
      </div>
</main>
<%- include('partials/footer') %>
