<%- include('partials/header') %>
<main class="flex-grow bg-[#F7F7F7] py-8">
  <div class="container max-w-2xl mx-auto">
    <div class="bg-white p-8 rounded-lg shadow-sm border border-[#DEE2E7]">
      <div class="flex items-center gap-3 mb-6">
        <i data-lucide="plus-circle" class="w-6 h-6 text-primary"></i>
        <h2 class="text-2xl font-bold text-[#1C1C1C]">Add New Product</h2>
      </div>

      <form action="/products/add" method="POST" class="space-y-5">
        
        <div class="grid grid-cols-2 gap-5">
          <div>
            <label class="block text-sm font-medium text-[#1C1C1C] mb-1">Product Title</label>
            <input type="text" name="title" required placeholder="e.g. Wireless Mouse" class="w-full border border-[#DEE2E7] rounded-md px-4 py-2 outline-none focus:border-primary">
          </div>
          <div>
            <label class="block text-sm font-medium text-[#1C1C1C] mb-1">Category</label>
            <select name="category" required class="w-full border border-[#DEE2E7] rounded-md px-4 py-2 outline-none focus:border-primary">
              <option value="Electronics">Electronics</option>
              <option value="Smartphones">Smartphones</option>
              <option value="Modern tech">Modern tech</option>
              <option value="Mobile accessory">Mobile accessory</option>
              <option value="Clothing">Clothing</option>
              <option value="Other">Other</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-3 gap-5">
          <div>
            <label class="block text-sm font-medium text-[#1C1C1C] mb-1">Price ($)</label>
            <input type="number" step="0.01" name="price" required placeholder="99.99" class="w-full border border-[#DEE2E7] rounded-md px-4 py-2 outline-none focus:border-primary">
          </div>
          <div>
            <label class="block text-sm font-medium text-[#1C1C1C] mb-1">Brand</label>
            <input type="text" name="brand" placeholder="e.g. Apple" class="w-full border border-[#DEE2E7] rounded-md px-4 py-2 outline-none focus:border-primary">
          </div>
          <div>
            <label class="block text-sm font-medium text-[#1C1C1C] mb-1">Condition</label>
            <select name="condition" class="w-full border border-[#DEE2E7] rounded-md px-4 py-2 outline-none focus:border-primary">
              <option value="Brand new">Brand new</option>
              <option value="Refurbished">Refurbished</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-[#1C1C1C] mb-1">Image URL</label>
          <input type="text" name="image" required placeholder="/assets/Image/tech/8.png" class="w-full border border-[#DEE2E7] rounded-md px-4 py-2 outline-none focus:border-primary">
          <p class="text-xs text-secondary mt-1">Provide a relative path to your public asset or an external URL.</p>
        </div>

        <div>
          <label class="block text-sm font-medium text-[#1C1C1C] mb-1">Description</label>
          <textarea name="description" rows="4" required placeholder="Describe the product..." class="w-full border border-[#DEE2E7] rounded-md px-4 py-2 outline-none focus:border-primary resize-none"></textarea>
        </div>

        <div class="pt-4 border-t border-[#DEE2E7]">
          <button type="submit" class="bg-primary hover:bg-primary-dark text-white font-bold py-3 px-6 rounded-md transition-colors w-full sm:w-auto">
            Publish Product
          </button>
        </div>

      </form>
    </div>
  </div>
</main>
<%- include('partials/footer') %>
