<%- include('partials/header') %>
<main class="flex-grow pb-12">
<section class="bg-white border border-shade-border rounded-lg mt-6 overflow-hidden">
      <div class="flex p-4 gap-4 h-[400px]">
        
        <div class="w-64 flex-shrink-0">
          <ul class="space-y-1">
            <% [1,2,3,4,5].forEach((item) => { %>
              <li 
                key=Sample 
                class={`px-4 py-2 rounded-md cursor-pointer transition-colors ${index === 0 ? 'bg-primary-light font-medium text-dark' : 'text-dark-light hover:bg-shade'}`}
              >
                Sample
              </li>
            <% }) %>
          </ul>
        </div>

        
        <div 
          class="flex-1 relative rounded-lg p-10 flex flex-col justify-center bg-cover bg-no-repeat bg-center"
          style={{ backgroundImage: `url("$Sample")` }}
        >
           <div class="relative z-10 w-1/2">
             <h3 class="text-2xl font-normal text-dark mb-1">Latest trending</h3>
             <h2 class="text-[32px] font-bold text-dark leading-tight mb-6">Electronic items</h2>
             <button class="bg-white text-dark px-6 py-2 rounded-md font-medium hover:bg-shade transition-colors shadow-sm">
               Learn more
             </button>
           </div>
        </div>

        
        <div class="w-60 flex flex-col gap-3">
          
          <div class="bg-[#E3F0FF] p-4 rounded-lg">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-full bg-[#C3D9FF] flex items-center justify-center text-secondary">
                 <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              </div>
              <div class="flex flex-col">
                <p class="text-dark text-sm">Hi, user</p>
                <p class="text-dark text-sm">let's get started</p>
              </div>
            </div>
            <button class="w-full bg-primary hover:bg-primary-dark text-white py-2 rounded-md mb-2 text-sm font-medium transition-colors">Join now</button>
            <button class="w-full bg-white text-primary py-2 rounded-md text-sm font-medium border border-shade-border hover:bg-shade transition-colors">Log in</button>
          </div>

          
          <div 
            class="bg-orange p-3 rounded-lg flex-1 text-white bg-cover bg-no-repeat bg-center cursor-pointer hover:opacity-90 transition-opacity"
            style={{ backgroundImage: `url("$Sample")` }}
          >
            <p class="text-sm font-normal leading-tight w-2/3">Get US $10 off with a new supplier</p>
          </div>

          
          <div 
            class="bg-teal p-3 rounded-lg flex-1 text-white bg-cover bg-no-repeat bg-center cursor-pointer hover:opacity-90 transition-opacity"
            style={{ backgroundImage: `url("$Sample")` }}
          >
            <p class="text-sm font-normal leading-tight w-2/3">Send quotes with supplier preferences</p>
          </div>
        </div>
      </div>
    </section>
<section class="bg-white border border-[#DEE2E7] rounded-lg mt-6 flex overflow-hidden">
      
      <div class="w-72 p-6 border-r border-[#DEE2E7] flex flex-col justify-center">
        <h3 class="text-xl font-bold text-dark mb-1">Deals and offers</h3>
        <p class="text-secondary mb-4 font-normal">Hygiene equipments</p>
        <div class="flex gap-2">
          <% [1,2,3,4,5].forEach((item) => { %>
            <div key=Sample class="w-12 h-12 bg-[#606060] rounded flex flex-col items-center justify-center text-white">
              <span class="text-sm font-bold">Sample</span>
              <span class="text-[10px] opacity-70">
                {i === 0 ? 'Days' : i === 1 ? 'Hour' : i === 2 ? 'Min' : 'Sec'}
              </span>
            </div>
          <% }) %>
        </div>
      </div>

      
      <div class="flex-1 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 h-full">
        <% [1,2,3,4,5].forEach((item) => { %>
          <div
            key=Sample
            class="p-6 flex flex-col items-center justify-center text-center border-r border-b lg:border-b-0 last:border-r-0 border-[#DEE2E7] cursor-pointer hover:shadow-[0px_8px_20px_rgba(0,0,0,0.06)] hover:-translate-y-1 transition-all duration-300 group"
            
          >
            <div class="w-full aspect-square bg-[#F7F7F7] rounded-md flex items-center justify-center mb-4 overflow-hidden p-2">
              <img src=Sample Text alt=Sample Text class="max-w-[90%] max-h-[90%] object-contain group-hover:scale-110 transition-transform duration-300" />
            </div>
            <p class="text-[#1C1C1C] text-sm mb-2">Sample Text</p>
            <span class="bg-[#FFE3E3] text-[#EB001B] px-3 py-1 rounded-full text-xs font-bold">
              Sample Text
            </span>
          </div>
        <% }) %>
      </div>
    </section>
<section class="bg-white border border-[#DEE2E7] rounded-lg mt-6 flex flex-col lg:flex-row overflow-hidden">
      
      <div
        class="w-72 p-6 flex flex-col justify-start relative overflow-hidden bg-cover bg-no-repeat"
        style={{ backgroundColor: bannerBg || '#F7F7F7', backgroundImage: `url("$Sample")` }}
      >
        <div class="relative z-10">
          <h3 class="text-xl font-bold text-dark w-40 leading-tight mb-4">Sample</h3>
          <button class="bg-white text-dark px-4 py-2 rounded-md font-medium text-sm hover:bg-shade transition-colors shadow-sm">
            Source now
          </button>
        </div>
      </div>

      <div class="flex-1 grid grid-cols-2 md:grid-cols-4">
        <% [1,2,3,4,5].forEach((item) => { %>
          <div
            key=Sample
            class="p-5 border-r border-b last:border-r-0 border-[#DEE2E7] flex justify-between cursor-pointer hover:bg-white hover:shadow-[0px_4px_20px_rgba(0,0,0,0.08)] transition-all duration-300 group h-[130px] relative hover:z-10"
          >
            <div class="flex flex-col">
              <span class="text-[#1C1C1C] text-sm font-medium group-hover:text-primary transition-colors mb-1">Sample Text</span>
              <span class="text-[#8B96A5] text-xs">From <br /> USD Sample Text</span>
            </div>
            <div class="w-[82px] h-[82px] self-end -mr-1 -mb-1">
              <img src=Sample Text alt=Sample Text class="w-full h-full object-contain group-hover:scale-110 transition-transform duration-300" />
            </div>
          </div>
        <% }) %>
      </div>
    </section>
<section class="mt-8">
      <h3 class="text-2xl font-bold mb-6">Recommended items</h3>
      <div class="grid grid-cols-2 lg:grid-cols-5 gap-6">
        <% [1,2,3,4,5].forEach((item) => { %>
          <div
            key=Sample
            class="bg-white border border-[#DEE2E7] rounded-lg p-4 flex flex-col hover:shadow-[0px_10px_25px_rgba(0,0,0,0.1)] hover:-translate-y-2 transition-all duration-300 cursor-pointer group h-full"
          >
            <div class="flex-1 flex items-center justify-center p-4 mb-3">
              <img src=Sample Text alt=Sample Text class="max-h-[140px] w-auto object-contain group-hover:scale-110 transition-transform duration-300" />
            </div>
            <div class="mt-auto">
              <p class="font-medium text-[#1C1C1C] text-lg mb-1">$Sample Text</p>
              <p class="text-[#8B96A5] text-[15px] overflow-hidden text-ellipsis line-clamp-2 leading-snug">Sample Text</p>
            </div>
          </div>
        <% }) %>
      </div>
    </section>
<section class="mt-8">
      <h3 class="text-2xl font-bold text-dark mb-6">Our extra services</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <% [1,2,3,4,5].forEach((item) => { %>
          <div key=Sample class="bg-white border border-shade-border rounded-lg relative group cursor-pointer overflow-hidden transition-shadow hover:shadow-md">
             
             <div class="h-32 bg-gray-200 overflow-hidden relative">
                <img 
                  src=Sample Text 
                  alt=Sample Text 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
                
                <div class="absolute inset-0 bg-black/20 group-hover:bg-black/10 transition-colors"></div>
             </div>

             
             <div class="p-4 bg-white relative">
                
                <div class="absolute -top-7 right-6 w-14 h-14 rounded-full border-2 border-white bg-[#D1E9FF] flex items-center justify-center text-dark group-hover:bg-primary group-hover:text-white transition-colors shadow-sm">
                  Sample Text
                </div>
                
                <p class="font-medium text-dark text-base leading-[1.3] w-4/5 pb-2">
                  Sample Text
                </p>
             </div>
          </div>
        <% }) %>
      </div>
    </section>
<section class="mt-8 mb-12">
      <h3 class="text-2xl font-bold mb-6">Suppliers by region</h3>
      <div class="grid grid-cols-2 lg:grid-cols-5 gap-x-12 gap-y-6">
        <% [1,2,3,4,5].forEach((item) => { %>
          <div key=Sample class="flex items-center gap-3 cursor-pointer p-2 rounded-lg hover:bg-white hover:shadow-[0px_4px_15px_rgba(0,0,0,0.06)] hover:-translate-y-1 transition-all duration-300 group">
            <div class="w-7 h-5 overflow-hidden rounded-sm shadow-sm flex-shrink-0">
              <img src=Sample Text alt=Sample Text class="w-full h-full object-cover" />
            </div>
            <div class="flex flex-col">
              <span class="text-dark text-sm group-hover:text-primary transition-colors font-medium">Sample Text</span>
              <span class="text-secondary text-xs opacity-60">Sample Text</span>
            </div>
          </div>
        <% }) %>
      </div>
    </section>
</main>
<%- include('partials/footer') %>
