<%- include('partials/header') %>
<main class="flex-grow flex items-center justify-center bg-[#F7F7F7] py-12">
  <div class="bg-white p-8 rounded-lg shadow-sm border border-[#DEE2E7] w-full max-w-md">
    <h2 class="text-2xl font-bold text-center text-[#1C1C1C] mb-6">Register</h2>
    
    <% if (error) { %>
      <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4">
        <span class="block sm:inline"><%= error %></span>
      </div>
    <% } %>

    <form action="/auth/signup" method="POST" class="space-y-4">
      <div>
        <label class="block text-sm font-medium text-[#1C1C1C] mb-1">Full Name</label>
        <input type="text" name="name" required placeholder="Type your name" class="w-full border border-[#DEE2E7] rounded-md px-4 py-2 outline-none focus:border-primary">
      </div>
      <div>
        <label class="block text-sm font-medium text-[#1C1C1C] mb-1">Email address</label>
        <input type="email" name="email" required placeholder="Type your email" class="w-full border border-[#DEE2E7] rounded-md px-4 py-2 outline-none focus:border-primary">
      </div>
      <div>
        <label class="block text-sm font-medium text-[#1C1C1C] mb-1">Password</label>
        <input type="password" name="password" required placeholder="Create a password" class="w-full border border-[#DEE2E7] rounded-md px-4 py-2 outline-none focus:border-primary">
      </div>
      <button type="submit" class="w-full bg-primary hover:bg-primary-dark text-white font-bold py-2 px-4 rounded-md transition-colors mt-2">
        Register
      </button>
    </form>
    <div class="mt-6 text-center text-sm text-[#505050]">
      Already have an account? <a href="/auth/login" class="text-primary hover:underline">Log in</a>
    </div>
  </div>
</main>
<%- include('partials/footer') %>
