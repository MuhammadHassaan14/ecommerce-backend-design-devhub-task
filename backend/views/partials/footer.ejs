            <div class="flex flex-col gap-2">
              <a href="#" class="bg-[#1C1C1C] text-white flex items-center gap-2 px-3 py-2 rounded-lg hover:opacity-90 transition-opacity w-[140px]">
                <i data-lucide="Apple" class="w-[20px] h-[20px]"></i>
                <div class="flex flex-col">
                  <span class="text-[8px] uppercase leading-none">Download on the</span>
                  <span class="text-[12px] font-bold leading-none">App Store</span>
                </div>
              </a>
              <a href="#" class="bg-[#1C1C1C] text-white flex items-center gap-2 px-3 py-2 rounded-lg hover:opacity-90 transition-opacity w-[140px]">
