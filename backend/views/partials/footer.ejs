              <li><a href="#" class="hover:text-primary transition-colors">Help Center</a></li>
              <li><a href="#" class="hover:text-primary transition-colors">Money Refund</a></li>
              <li><a href="#" class="hover:text-primary transition-colors">Shipping</a></li>
              <li><a href="#" class="hover:text-primary transition-colors">Contact us</a></li>
            </ul>
          </div>
          <div class="lg:col-span-2">
            <h4 class="font-bold text-[#1C1C1C] mb-4">For users</h4>
            <ul class="space-y-3 text-[#8B96A5] text-sm">
              <li><a href="#" class="hover:text-primary transition-colors">Login</a></li>
              <li><a href="#" class="hover:text-primary transition-colors">Register</a></li>
              <li><a href="#" class="hover:text-primary transition-colors">Settings</a></li>
              <li><a href="#" class="hover:text-primary transition-colors">My Orders</a></li>
            </ul>
          </div>

          <div class="lg:col-span-2">
