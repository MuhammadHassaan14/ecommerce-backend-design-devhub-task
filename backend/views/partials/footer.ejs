          <p class="text-[#606060] text-sm">© 2023 Ecommerce.</p>
          <div class="flex items-center gap-4 text-dark text-sm">
             <div class="flex items-center gap-2 cursor-pointer hover:text-primary transition-colors">
               <img src="/assets/Layout1/Image/flags/DE@2x.png" alt="US" class="w-[20px] h-[14px]" />
               <span>English</span>
               <i data-lucide="chevron-up"></i>
             </div>
          </div>
        </div>
      </div>
