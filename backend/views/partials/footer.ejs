<section class="bg-shade py-12 flex flex-col items-center text-center">
      <h3 class="text-xl font-bold text-dark mb-1">Subscribe on our newsletter</h3>
      <p class="text-secondary mb-8">Get daily news on upcoming offers from many suppliers all over the world</p>
      
      <form class="flex gap-2 w-full max-w-md">
        <div class="flex-1 relative">
           <i data-lucide="mail"></i>
           <input 
            type="email" 
            placeholder="Email" 
            class="w-full pl-10 pr-4 py-2 border border-shade-border rounded-md outline-none focus:ring-1 focus:ring-primary"
          />
        </div>
        <button class="bg-primary hover:bg-primary-dark text-white px-6 py-2 rounded-md font-medium transition-colors">
          Subscribe
        </button>
      </form>
    </section>
<footer class="bg-white border-t border-shade-border pt-12">
      <div class="container pb-12">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-8 lg:gap-12">
          
          <div class="lg:col-span-3">
            <div class="mb-4">
               <img src="/assets/Layout1/Image/flags/DE@2x.png" alt="Brand" class="h-[46px]" />
            </div>
            <p class="text-[#505050] text-[#1C1C1C] opacity-80 max-w-xs mb-6 text-sm leading-relaxed">
              Best information about the company gies here but now lorem ipsum is simply dummy text of the printing and typesetting industry.
            </p>
            <div class="flex gap-3">
              <% [1,2,3,4,5].forEach((item) => { %>
                <a key=Sample href="#" class="w-8 h-8 rounded-full bg-[#BDC4CD] flex items-center justify-center text-white hover:bg-primary transition-all">
                  <i data-lucide="icon"></i>
                </a>
              <% }) %>
            </div>
          </div>

          
          <div class="lg:col-span-1">
            <h4 class="font-bold text-[#1C1C1C] mb-4">About</h4>
            <ul class="space-y-3 text-[#8B96A5] text-sm">
              <li><a href="#" class="hover:text-primary transition-colors">About Us</a></li>
              <li><a href="#" class="hover:text-primary transition-colors">Find store</a></li>
              <li><a href="#" class="hover:text-primary transition-colors">Categories</a></li>
              <li><a href="#" class="hover:text-primary transition-colors">Blogs</a></li>
            </ul>
          </div>
          <div class="lg:col-span-2">
            <h4 class="font-bold text-[#1C1C1C] mb-4">Partnership</h4>
            <ul class="space-y-3 text-[#8B96A5] text-sm">
              <li><a href="#" class="hover:text-primary transition-colors">About Us</a></li>
              <li><a href="#" class="hover:text-primary transition-colors">Find store</a></li>
              <li><a href="#" class="hover:text-primary transition-colors">Categories</a></li>
              <li><a href="#" class="hover:text-primary transition-colors">Blogs</a></li>
            </ul>
          </div>
          <div class="lg:col-span-2">
            <h4 class="font-bold text-[#1C1C1C] mb-4">Information</h4>
