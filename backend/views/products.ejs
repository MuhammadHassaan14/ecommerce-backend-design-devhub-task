<%- include('partials/header') %>
<main class="flex-grow pb-12">
<div class="container py-4">
      
      <div class="flex items-center gap-2 text-[#8B96A5] text-sm mb-6">
        <span class="cursor-pointer hover:text-primary transition-colors" >Home</span>
        <i data-lucide="chevron-right"></i>
        <span class="cursor-pointer hover:text-primary transition-colors">Clothings</span>
        <i data-lucide="chevron-right"></i>
        <span class="cursor-pointer hover:text-primary transition-colors">Men's wear</span>
        <i data-lucide="chevron-right"></i>
        <span class="text-[#1C1C1C] font-normal">Summer clothing</span>
      </div>

      <div class="flex gap-6">
        
        <aside class="w-[240px] flex-shrink-0 space-y-2">
          
          <div class="border-t border-[#DEE2E7] py-3">
            <h4 class="font-bold text-[#1C1C1C] mb-3 flex justify-between items-center cursor-pointer">
              Category <i data-lucide="chevron-down"></i>
            </h4>
            <ul class="space-y-3 text-[#505050] text-sm">
              <li class="hover:text-primary cursor-pointer">Mobile accessory</li>
              <li class="hover:text-primary cursor-pointer">Electronics</li>
              <li class="hover:text-primary cursor-pointer">Smartphones</li>
              <li class="hover:text-primary cursor-pointer">Modern tech</li>
              <li class="text-primary cursor-pointer mt-1">See all</li>
            </ul>
          </div>

          
          <div class="border-t border-[#DEE2E7] py-3">
            <h4 class="font-bold text-[#1C1C1C] mb-3 flex justify-between items-center cursor-pointer">
              Brands <i data-lucide="chevron-down"></i>
            </h4>
            <div class="space-y-2">
              {["Samsung", "Apple", "Huawei", "Pocco", "Lenovo"].map(brand => (
                <label key=Sample class="flex items-center gap-3 text-[#1C1C1C] text-sm cursor-pointer group">
                  <input type="checkbox" checked class="w-4 h-4 rounded border-[#DEE2E7] text-primary focus:ring-primary" />
                  <span class="group-hover:text-primary transition-colors">Sample</span>
                </label>
              <% }) %>
              <div class="text-primary text-sm cursor-pointer pt-1">See all</div>
            </div>
          </div>

          
          <div class="border-t border-[#DEE2E7] py-3">
            <h4 class="font-bold text-[#1C1C1C] mb-3 flex justify-between items-center cursor-pointer">
              Features <i data-lucide="chevron-down"></i>
            </h4>
            <div class="space-y-2">
              {["Metallic", "Plastic cover", "8GB RAM", "Super power", "Large Memory"].map(feature => (
                <label key=Sample class="flex items-center gap-3 text-[#1C1C1C] text-sm cursor-pointer group">
                  <input type="checkbox" checked class="w-4 h-4 rounded border-[#DEE2E7] text-primary focus:ring-primary" />
                  <span class="group-hover:text-primary transition-colors">Sample</span>
                </label>
              <% }) %>
              <div class="text-primary text-sm cursor-pointer pt-1">See all</div>
            </div>
          </div>

          
          <div class="border-t border-[#DEE2E7] py-3">
            <h4 class="font-bold text-[#1C1C1C] mb-3 flex justify-between items-center cursor-pointer">
              Price range <i data-lucide="chevron-down"></i>
            </h4>
            <div class="space-y-4">
              <div class="relative h-6 flex items-center">
                <div class="w-full h-1 bg-[#DEE2E7] rounded"></div>
                <div class="absolute left-[20%] right-[30%] h-1 bg-primary rounded"></div>
                <div class="absolute left-[20%] w-4 h-4 bg-white border-2 border-primary rounded-full -ml-2"></div>
                <div class="absolute right-[30%] w-4 h-4 bg-white border-2 border-primary rounded-full -mr-2"></div>
              </div>
              <div class="flex gap-2">
                <div class="flex-1">
                  <p class="text-[#1C1C1C] text-xs mb-1">Min</p>
                  <input type="text" placeholder="0" class="w-full border border-[#DEE2E7] rounded-md px-3 py-2 text-sm outline-none focus:border-primary" />
                </div>
                <div class="flex-1">
                  <p class="text-[#1C1C1C] text-xs mb-1">Max</p>
                  <input type="text" placeholder="999999" class="w-full border border-[#DEE2E7] rounded-md px-3 py-2 text-sm outline-none focus:border-primary" />
                </div>
              </div>
              <button class="w-full bg-white border border-[#DEE2E7] text-primary py-2 rounded-md text-sm font-medium hover:bg-shade transition-colors shadow-sm">
                Apply
              </button>
            </div>
          </div>

          
          <div class="border-t border-[#DEE2E7] py-3">
            <h4 class="font-bold text-[#1C1C1C] mb-3 flex justify-between items-center cursor-pointer">
              Condition <i data-lucide="chevron-down"></i>
            </h4>
            <div class="space-y-2">
              <% [1,2,3,4,5].forEach((item) => { %>
                <label key=Sample class="flex items-center gap-3 text-[#1C1C1C] text-sm cursor-pointer group">
                  <input type="radio" name="condition" checked class="w-4 h-4 border-[#DEE2E7] text-primary focus:ring-primary" />
                  <span class="group-hover:text-primary transition-colors">Sample</span>
                </label>
              <% }) %>
            </div>
          </div>

          
          <div class="border-t border-[#DEE2E7] py-3 pb-4">
            <h4 class="font-bold text-[#1C1C1C] mb-3 flex justify-between items-center cursor-pointer">
              Ratings <i data-lucide="chevron-down"></i>
            </h4>
            <div class="space-y-2">
              <% [1,2,3,4,5].forEach((item) => { %>
                <label key=Sample class="flex items-center gap-3 cursor-pointer group">
                  <input type="checkbox" checked class="w-4 h-4 rounded border-[#DEE2E7] text-primary focus:ring-primary" />
                  <div class="flex gap-0.5">
                    <% [1,2,3,4,5].forEach((item) => { %>
                      <i data-lucide="Star" class="w-[14px] h-[14px]"></i>
                    <% }) %>
                  </div>
                </label>
              <% }) %>
            </div>
          </div>
        </aside>

        
        <main class="flex-1">
          
          <div class="bg-white border border-[#DEE2E7] rounded-lg p-4 flex items-center justify-between mb-4">
            <span class="text-[#1C1C1C] text-sm">12,911 items in <span class="font-bold">Mobile accessory</span></span>
            <div class="flex items-center gap-4">
              <label class="flex items-center gap-2 cursor-pointer text-sm font-normal">
                <input type="checkbox" class="w-4 h-4 rounded border-[#DEE2E7] text-primary focus:ring-primary" />
                <span>Verified only</span>
              </label>
              <div class="flex items-center gap-2 border border-[#DEE2E7] rounded-md px-3 py-1 bg-white cursor-pointer hover:bg-shade transition-colors">
                <span class="text-sm">Featured</span>
                <i data-lucide="chevron-down"></i>
              </div>
              <div class="flex border border-[#DEE2E7] rounded-md overflow-hidden">
                <div
                  class={`p-2 border-r border-[#DEE2E7] cursor-pointer transition-colors ${viewMode === 'grid' ? 'bg-[#EFF2F4]' : 'hover:bg-shade'}`}
                  
                >
                  <i data-lucide="Grid" class="w-[18px] h-[18px]"></i>
                </div>
                <div
                  class={`p-2 cursor-pointer transition-colors ${viewMode === 'list' ? 'bg-[#EFF2F4]' : 'hover:bg-shade'}`}
                  
                >
                  <i data-lucide="List" class="w-[18px] h-[18px]"></i>
                </div>
              </div>
            </div>
          </div>

          
          <div class="flex flex-wrap items-center gap-2 mb-4">
            <% [1,2,3,4,5].forEach((item) => { %>
              <div key=Sample class="flex items-center gap-2 px-3 py-1.5 border border-primary rounded-md bg-white text-dark text-sm">
                <span>Sample</span>
                <i data-lucide="X" class="w-[14px] h-[14px]"></i>
              </div>
            <% }) %>
            <button class="text-primary text-sm font-normal hover:underline ml-2">
              Clear all filter
            </button>
          </div>

          {viewMode === 'list' ? (
            /* Product List View */
            <div class="space-y-3">
              <% [1,2,3,4,5].forEach((item) => { %>
                <div key=Sample Text class="bg-white border border-[#DEE2E7] rounded-lg p-5 flex gap-6 hover:shadow-md transition-shadow group cursor-pointer relative" >
                  
                  <div class="w-[210px] h-[210px] lg:w-[240px] lg:h-[240px] flex-shrink-0 flex items-center justify-center bg-[#F7F7F7] rounded-lg p-6 relative overflow-hidden group">
                    <img src=Sample Text alt=Sample Text class="max-w-full max-h-full object-contain group-hover:scale-110 transition-transform duration-300" />
                  </div>

                  
                  <button class="absolute right-5 top-5 w-10 h-10 border border-[#DEE2E7] rounded-md flex items-center justify-center text-primary hover:bg-primary hover:text-white transition-all shadow-sm" >
                    <i data-lucide="Heart" class="w-[20px] h-[20px]"></i>
                  </button>

                  
                  <div class="flex-1 py-1">
                    <h3 class="text-[#1C1C1C] text-base font-semibold group-hover:text-primary transition-colors mb-3">Sample Text</h3>
                    <div class="flex items-center gap-4 mb-3">
                      <div class="flex flex-col">
                        <span class="text-xl font-bold text-[#1C1C1C]">$Sample Text</span>
                        {product.oldPrice && <span class="text-[#8B96A5] line-through text-sm mt-0.5">$Sample Text</span>}
                      </div>
                    </div>

                    
                    <div class="flex items-center gap-2 mb-4">
                      <div class="flex gap-0.5">
                        <% [1,2,3,4,5].forEach((item) => { %>
                          <i data-lucide="Star" class="w-[14px] h-[14px]"></i>
                        <% }) %>
                      </div>
                      <span class="text-[#FF9017] text-sm font-medium">Sample Text</span>
                      <span class="text-[#8B96A5] text-sm ml-2">• Sample Text orders</span>
                      <span class="text-[#00B517] text-sm font-medium ml-2">• Sample Text</span>
                    </div>

                    <p class="text-[#505050] text-sm leading-relaxed mb-4 line-clamp-2 max-w-2xl">
                      Sample Text
                    </p>

                    <button class="text-primary font-bold text-sm bg-transparent border-none p-0 hover:underline">
                      View details
                    </button>
                  </div>
                </div>
              <% }) %>
            </div>
          ) : (
            /* Product Grid View */
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
              <% [1,2,3,4,5].forEach((item) => { %>
                <div
                  key=Sample Text
                  class="bg-white border border-[#DEE2E7] rounded-lg p-4 hover:shadow-[0px_8px_25px_rgba(0,0,0,0.1)] hover:-translate-y-1 transition-all duration-300 group flex flex-col items-center cursor-pointer"
                  
                >
                  
                  <div class="w-full aspect-square flex items-center justify-center mb-4 bg-[#F7F7F7] rounded-md p-6 overflow-hidden">
                    <img src=Sample Text alt=Sample Text class="max-w-[85%] max-h-[85%] object-contain group-hover:scale-110 transition-transform duration-300" />
                  </div>

                  
                  <div class="w-full">
                    <div class="flex items-center justify-between mb-2">
                      <div class="flex flex-col">
                        <div class="flex items-center gap-2">
                          <span class="text-lg font-bold text-[#1C1C1C]">$Sample Text</span>
                          <button class="w-8 h-8 border border-[#DEE2E7] rounded-md flex items-center justify-center text-primary hover:bg-primary hover:text-white transition-all shadow-sm" >
                            <i data-lucide="Heart" class="w-[16px] h-[16px]"></i>
                          </button>
                        </div>
                        {product.oldPrice && <span class="text-[#8B96A5] line-through text-xs">$Sample Text</span>}
                      </div>
                    </div>

                    
                    <div class="flex items-center gap-1 mb-3">
                      <div class="flex gap-0.5">
                        <% [1,2,3,4,5].forEach((item) => { %>
                          <i data-lucide="Star" class="w-[12px] h-[12px]"></i>
                        <% }) %>
                      </div>
                      <span class="text-[#FF9017] text-xs font-medium">Sample Text</span>
                    </div>

                    
                    <h3 class="text-[#505050] text-[13px] leading-[1.4] line-clamp-2 hover:text-primary transition-colors">
                      Sample Text
                    </h3>
                  </div>
                </div>
              <% }) %>
            </div>
          )}

          
          <div class="flex justify-end mt-8">
            <div class="flex items-center gap-3">
              <div class="flex border border-[#DEE2E7] rounded-md overflow-hidden bg-white">
                <div class="px-3 py-2 border-r border-[#DEE2E7] cursor-pointer hover:bg-shade transition-colors flex items-center">
                  <span class="text-secondary text-sm">Show 10</span>
                  <i data-lucide="ChevronDown" class="w-[14px] h-[14px]"></i>
                </div>
              </div>
              <div class="flex border border-[#DEE2E7] rounded-md overflow-hidden bg-white">
                <div class="px-3 py-2 border-r border-[#DEE2E7] opacity-30 cursor-not-allowed text-dark flex items-center">{"<"}</div>
                <div class="px-4 py-2 border-r border-[#DEE2E7] bg-white hover:bg-shade font-bold text-dark text-sm cursor-pointer">1</div>
                <div class="px-4 py-2 border-r border-[#DEE2E7] hover:bg-shade cursor-pointer text-dark text-sm transition-colors">2</div>
                <div class="px-4 py-2 border-r border-[#DEE2E7] hover:bg-shade cursor-pointer text-dark text-sm transition-colors">3</div>
                <div class="px-3 py-2 hover:bg-shade cursor-pointer text-dark flex items-center transition-colors shadow-sm">{">"}</div>
              </div>
            </div>
          </div>
        </main>
      </div>
    </div>
</main>
<%- include('partials/footer') %>
