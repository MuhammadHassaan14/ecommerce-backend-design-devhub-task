<%- include('partials/header') %>
<main class="flex-grow pb-12">
<div class="container py-4">
      
      <div class="flex items-center gap-2 text-[#8B96A5] text-sm mb-6">
        <a href="/" class="cursor-pointer hover:text-primary transition-colors" >Home</a>
        <i data-lucide="chevron-right"></i>
        <a href="/products" class="cursor-pointer hover:text-primary transition-colors">Products</a>
      </div>

      <div class="flex gap-6">
        
        <aside class="w-[240px] flex-shrink-0 space-y-2 hidden md:block">
          
          <div class="border-t border-[#DEE2E7] py-3">
            <h4 class="font-bold text-[#1C1C1C] mb-3 flex justify-between items-center cursor-pointer">
              Category <i data-lucide="chevron-down"></i>
            </h4>
            <ul class="space-y-3 text-[#505050] text-sm">
              <li><a href="/products?category=Mobile accessory" class="hover:text-primary cursor-pointer <%= selectedCategory === 'Mobile accessory' ? 'text-primary' : '' %>">Mobile accessory</a></li>
              <li><a href="/products?category=Electronics" class="hover:text-primary cursor-pointer <%= selectedCategory === 'Electronics' ? 'text-primary' : '' %>">Electronics</a></li>
              <li><a href="/products?category=Smartphones" class="hover:text-primary cursor-pointer <%= selectedCategory === 'Smartphones' ? 'text-primary' : '' %>">Smartphones</a></li>
              <li><a href="/products?category=Modern tech" class="hover:text-primary cursor-pointer <%= selectedCategory === 'Modern tech' ? 'text-primary' : '' %>">Modern tech</a></li>
              <li class="text-primary cursor-pointer mt-1">See all</li>
            </ul>
          </div>
        </aside>

        
        <main class="flex-1">
          
          <div class="bg-white border border-[#DEE2E7] rounded-lg p-4 flex items-center justify-between mb-4">
            <span class="text-[#1C1C1C] text-sm"><%= products.length %> items found <% if(searchQuery) { %> for "<span class="font-bold"><%= searchQuery %></span>" <% } %></span>
            <div class="flex items-center gap-4">
              <label class="flex items-center gap-2 cursor-pointer text-sm font-normal hidden md:flex">
                <input type="checkbox" class="w-4 h-4 rounded border-[#DEE2E7] text-primary focus:ring-primary" />
                <span>Verified only</span>
              </label>
              <div class="flex items-center gap-2 border border-[#DEE2E7] rounded-md px-3 py-1 bg-white cursor-pointer hover:bg-shade transition-colors">
                <span class="text-sm">Featured</span>
                <i data-lucide="chevron-down"></i>
              </div>
            </div>
          </div>

          <div class="space-y-3">
            <% products.forEach((product) => { %>
              <div class="bg-white border border-[#DEE2E7] rounded-lg p-5 flex flex-col md:flex-row gap-6 hover:shadow-md transition-shadow group cursor-pointer relative" onclick="window.location.href='/products/<%= product._id %>'">
                
                <div class="w-full md:w-[210px] h-[210px] flex-shrink-0 flex items-center justify-center bg-[#F7F7F7] rounded-lg p-6 relative overflow-hidden group">
                  <img src="<%= product.image %>" alt="<%= product.title %>" class="max-w-full max-h-full object-contain group-hover:scale-110 transition-transform duration-300" />
                </div>

                <button class="absolute right-5 top-5 w-10 h-10 border border-[#DEE2E7] rounded-md flex items-center justify-center text-primary hover:bg-primary hover:text-white transition-all shadow-sm" >
                  <i data-lucide="heart" class="w-[20px] h-[20px]"></i>
                </button>

                <div class="flex-1 py-1">
                  <h3 class="text-[#1C1C1C] text-base font-semibold group-hover:text-primary transition-colors mb-3"><%= product.title %></h3>
                  <div class="flex items-center gap-4 mb-3">
                    <div class="flex flex-col">
                      <span class="text-xl font-bold text-[#1C1C1C]">$<%= product.price.toFixed(2) %></span>
                      <% if(product.oldPrice) { %>
                        <span class="text-[#8B96A5] line-through text-sm mt-0.5">$<%= product.oldPrice.toFixed(2) %></span>
                      <% } %>
                    </div>
                  </div>

                  <div class="flex items-center gap-2 mb-4 flex-wrap">
                    <div class="flex gap-0.5">
                      <% for(let i=0; i<5; i++) { %>
                        <i data-lucide="star" class="w-[14px] h-[14px] <%= i < Math.floor(product.rating) ? 'fill-[#FF9017] text-[#FF9017]' : 'text-[#D1D3D3]' %>"></i>
                      <% } %>
                    </div>
                    <span class="text-[#FF9017] text-sm font-medium"><%= product.rating %></span>
                    <span class="text-[#8B96A5] text-sm ml-2">• <%= product.orders %> orders</span>
                    <span class="text-[#00B517] text-sm font-medium ml-2">• <%= product.shipping %></span>
                  </div>

                  <p class="text-[#505050] text-sm leading-relaxed mb-4 line-clamp-2 max-w-2xl">
                    <%= product.description %>
                  </p>

                  <a href="/products/<%= product._id %>" class="text-primary font-bold text-sm bg-transparent border-none p-0 hover:underline">
                    View details
                  </a>
                </div>
              </div>
            <% }) %>
            
            <% if(products.length === 0) { %>
              <div class="text-center py-12 text-[#8B96A5]">
                No products found matching your search.
              </div>
            <% } %>
          </div>

        </main>
      </div>
    </div>
</main>
<%- include('partials/footer') %>
